// ==========================================================================
// e-sekooly — Schéma Prisma
// Module 1 : Fondation multi-écoles + Authentification + Rôles/Permissions
// Les modules suivants (élèves, enseignants, classes, finances, etc.)
// ajouteront leurs propres modèles dans ce même fichier, module par module.
// ==========================================================================

generator client {
  provider = "prisma-client-js"
}

// En mode "Offline" le datasource pointe vers un fichier SQLite local.
// En mode "Serveur" DATABASE_URL pointe vers PostgreSQL.
// La synchronisation entre les deux est gérée par le service sync (Module Sync).
datasource db {
  provider = "sqlite" // basculé en "sqlite" par le build offline (voir docs/OFFLINE.md)
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------------------------
// Types d'établissement
// --------------------------------------------------------------------------

model SchoolCategory {
  id       String                 @id @default(uuid())
  code     String                 @unique
  label    String // ex: "Primaire", "Collège", "Lycée", "Université"
  isSystem Boolean                @default(true)
  schools  SchoolSchoolCategory[]

  @@map("school_types")
}

model SchoolSchoolCategory {
  schoolId     String
  schoolTypeId String

  school     School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolType SchoolCategory @relation(fields: [schoolTypeId], references: [id], onDelete: Cascade)

  @@id([schoolId, schoolTypeId])
  @@index([schoolTypeId])
  @@map("school_school_types")
}

// --------------------------------------------------------------------------
// Multi-écoles / Multi-campus / Multi-années scolaires
// --------------------------------------------------------------------------

model School {
  id        String   @id @default(uuid())
  name      String
  shortName String?
  logoUrl   String?
  address   String?
  phone     String?
  email     String?
  website   String?
  currency  String   @default("EUR")
  timezone  String   @default("Indian/Antananarivo")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campuses    Campus[]
  schoolYears SchoolYear[]
  users       User[]
  auditLogs   AuditLog[]
  schoolTypes SchoolSchoolCategory[]

  @@map("schools")
}

model Campus {
  id       String  @id @default(uuid())
  schoolId String
  name     String
  address  String?
  isMain   Boolean @default(false)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("campuses")
}

model SchoolYear {
  id        String   @id @default(uuid())
  schoolId  String
  label     String // ex: "2026-2027"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  semesters Semester[]

  @@unique([schoolId, label])
  @@index([schoolId])
  @@map("school_years")
}

model Semester {
  id           String   @id @default(uuid())
  schoolYearId String
  label        String // ex: "Semestre 1" ou "Trimestre 2"
  startDate    DateTime
  endDate      DateTime

  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)

  @@index([schoolYearId])
  @@map("semesters")
}

// --------------------------------------------------------------------------
// Authentification / Utilisateurs / Rôles / Permissions
// --------------------------------------------------------------------------

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  label       String
  description String?
  isSystem    Boolean @default(true) // rôles standards non supprimables

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  code        String  @unique // ex: "students.create", "finance.invoices.read"
  module      String // ex: "students", "finance", "attendance"
  description String?

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String    @id @default(uuid())
  schoolId     String?
  firstName    String
  lastName     String
  email        String    @unique
  phone        String?
  passwordHash String
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  // 2FA (TOTP)
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school           School?            @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  roles            UserRole[]
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  employee         Employee?
  student          Student?
  messagesSent     Message[]          @relation("MessagesSent")
  messagesReceived MessageRecipient[] @relation("MessagesReceived")
  announcements    Announcement[]
  notifications    Notification[]

  @@index([schoolId])
  @@map("users")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ==========================================================================
// Module 2 : Gestion des élèves (+ modèle Classe minimal, complété au Module 4)
// ==========================================================================

model ClassRoom {
  id                String  @id @default(uuid())
  schoolId          String
  name              String // ex: "6ème A"
  level             String // ex: "6ème"
  track             String? // filière, ex: "Scientifique"
  section           String? // ex: "A"
  room              String? // salle assignée
  capacity          Int     @default(40)
  homeroomTeacherId String? // enseignant responsable

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  homeroomTeacher Employee?        @relation(fields: [homeroomTeacherId], references: [id], onDelete: SetNull)
  students        Student[]
  teacherSubjects TeacherSubject[]
  timetableSlots  TimetableSlot[]
  exams           Exam[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([homeroomTeacherId])
  @@map("class_rooms")
}

model Student {
  id             String   @id @default(uuid())
  schoolId       String
  userId         String?  @unique
  classRoomId    String?
  registrationNo String   @unique // matricule auto-généré, ex: "ESK-2026-000123"
  firstName      String
  lastName       String
  gender         String
  dateOfBirth    DateTime
  placeOfBirth   String?
  photoUrl       String?
  qrCodeToken    String   @unique // jeton encodé dans le QR code (présence, cantine, etc.)
  address        String?
  phone          String?
  email          String?
  status         String   @default("ACTIVE")
  enrolledAt     DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classRoom         ClassRoom?            @relation(fields: [classRoomId], references: [id], onDelete: SetNull)
  user              User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  guardians         StudentGuardian[]
  documents         StudentDocument[]
  history           StudentHistoryEvent[]
  attendances       StudentAttendance[]
  grades            Grade[]
  disciplineRecords DisciplineRecord[]
  invoices          Invoice[]
  financialAids     FinancialAid[]

  @@index([schoolId])
  @@index([userId])
  @@index([classRoomId])
  @@index([lastName, firstName])
  @@map("students")
}

// Lien élève <-> parent/tuteur (un élève peut avoir plusieurs tuteurs,
// un tuteur peut avoir plusieurs enfants — voir aussi Module "Parents")
model StudentGuardian {
  id             String  @id @default(uuid())
  studentId      String
  guardianUserId String // référence vers User (rôle PARENT)
  relationship   String // ex: "Père", "Mère", "Tuteur légal"
  isPrimary      Boolean @default(false)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianUserId])
  @@index([studentId])
  @@index([guardianUserId])
  @@map("student_guardians")
}

model StudentDocument {
  id         String   @id @default(uuid())
  studentId  String
  label      String // ex: "Acte de naissance", "Certificat médical"
  fileUrl    String
  uploadedAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_documents")
}

// Historique scolaire : changement de classe, suspension, exclusion, diplôme...
model StudentHistoryEvent {
  id        String   @id @default(uuid())
  studentId String
  type      String // ex: "CLASS_CHANGE", "SUSPENSION", "EXCLUSION", "GRADUATION", "RE_ENROLLMENT"
  fromValue String?
  toValue   String?
  reason    String?
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_history_events")
}

// ==========================================================================
// Module 3 : Enseignants & Ressources humaines
// ==========================================================================

model Subject {
  id           String  @id @default(uuid())
  schoolId     String
  name         String // ex: "Mathématiques"
  coefficient  Float   @default(1)
  hoursPerWeek Int     @default(1)
  program      String? // programme / contenu

  teacherSubjects TeacherSubject[]
  timetableSlots  TimetableSlot[]
  exams           Exam[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("subjects")
}

// Dossier "employé" — enseignants ET personnel administratif (RH).
// Un Teacher n'est qu'un Employee dont le rôle utilisateur est TEACHER;
// les autres employés (comptable, surveillant, etc.) utilisent le même modèle.
model Employee {
  id         String   @id @default(uuid())
  schoolId   String
  userId     String   @unique // référence vers User (compte de connexion)
  employeeNo String   @unique // ex: "EMP-2026-000045"
  position   String // poste, ex: "Enseignant de Mathématiques", "Comptable"
  department String? // ex: "Pédagogique", "Administratif"
  hireDate   DateTime
  degrees    String? // diplômes (texte libre ou JSON structuré selon besoin)
  photoUrl   String?
  isActive   Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaves           LeaveRequest[]
  salaryPayments   SalaryPayment[]
  teacherSubjects  TeacherSubject[]
  attendances      StaffAttendance[]
  homeroomOf       ClassRoom[]
  timetableSlots   TimetableSlot[]
  examSupervisions ExamSupervisor[]

  @@index([schoolId])
  @@map("employees")
}

// Enseignant <-> Matière <-> Classe (un enseignant peut enseigner plusieurs
// matières, dans plusieurs classes).
model TeacherSubject {
  id          String  @id @default(uuid())
  employeeId  String
  subjectId   String
  classRoomId String?

  employee  Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classRoom ClassRoom? @relation(fields: [classRoomId], references: [id], onDelete: SetNull)

  @@unique([employeeId, subjectId, classRoomId])
  @@index([employeeId])
  @@index([subjectId])
  @@map("teacher_subjects")
}

model LeaveRequest {
  id         String    @id @default(uuid())
  employeeId String
  type       String
  startDate  DateTime
  endDate    DateTime
  reason     String?
  status     String    @default("PENDING")
  decidedBy  String? // userId du valideur
  decidedAt  DateTime?

  createdAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("leave_requests")
}

model SalaryPayment {
  id         String    @id @default(uuid())
  employeeId String
  period     String // ex: "2026-08"
  baseAmount Float
  bonuses    Float     @default(0) // primes
  advances   Float     @default(0) // avances déjà versées, déduites
  deductions Float     @default(0)
  netAmount  Float
  paidAt     DateTime?

  createdAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, period])
  @@index([employeeId])
  @@map("salary_payments")
}

// Présence du personnel (enseignants et autres employés). La présence des
// élèves suit le même principe, voir StudentAttendance ci-dessous (Module 5).
model StaffAttendance {
  id         String    @id @default(uuid())
  employeeId String
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     String    @default("PRESENT")
  method     String    @default("MANUAL")
  note       String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([employeeId])
  @@map("staff_attendances")
}

// ==========================================================================
// Module 4 : Classes, Matières & Emploi du temps
// ==========================================================================

// Un créneau d'emploi du temps : une matière, un enseignant, une classe,
// dans une salle, à un jour/horaire donné. La détection de conflits (même
// enseignant, même classe ou même salle déjà occupés sur le créneau) est
// appliquée au niveau du service (timetable.service.ts) avant toute écriture.
model TimetableSlot {
  id          String  @id @default(uuid())
  schoolId    String
  classRoomId String
  subjectId   String
  teacherId   String
  dayOfWeek   String
  startTime   String // format "HH:mm", ex: "08:00"
  endTime     String // format "HH:mm", ex: "09:00"
  room        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classRoom ClassRoom @relation(fields: [classRoomId], references: [id], onDelete: Cascade)
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Employee  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([classRoomId])
  @@index([teacherId])
  @@index([dayOfWeek])
  @@map("timetable_slots")
}

// ==========================================================================
// Module 5 : Présence (Élèves & Personnel) — QR code, saisie rapide, rapports
// ==========================================================================

// Présence journalière d'un élève. Le pointage peut se faire par QR code
// (scan du badge élève, voir Student.qrCodeToken) ou par saisie rapide en
// masse pour toute une classe (exigences "QR Code" et "Saisie rapide").
model StudentAttendance {
  id          String    @id @default(uuid())
  schoolId    String
  studentId   String
  classRoomId String?
  date        DateTime
  status      String    @default("PRESENT")
  method      String    @default("MANUAL")
  checkInTime DateTime?
  recordedBy  String? // userId de la personne ayant saisi la présence
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([schoolId])
  @@index([studentId])
  @@index([classRoomId])
  @@index([date])
  @@map("student_attendances")
}

// ==========================================================================
// Module 6 : Examens, Notes & Bulletins
// ==========================================================================

// Une session d'examens regroupe plusieurs épreuves sur une période donnée
// (ex: "Composition du 1er trimestre"). Le bulletin est généré par élève,
// pour une session donnée, en agrégeant toutes ses notes de la session.
model ExamSession {
  id                 String   @id @default(uuid())
  schoolId           String
  semesterId         String?
  label              String // ex: "Composition du 1er trimestre"
  type               String   @default("DEVOIR")
  startDate          DateTime
  endDate            DateTime
  deliberationStatus String   @default("PENDING")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exams Exam[]

  @@index([schoolId])
  @@map("exam_sessions")
}

// Une épreuve : une matière, une classe, dans une salle, à une date donnée,
// au sein d'une session d'examens.
model Exam {
  id            String   @id @default(uuid())
  examSessionId String
  subjectId     String
  classRoomId   String
  date          DateTime
  room          String?
  maxScore      Float    @default(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  examSession ExamSession      @relation(fields: [examSessionId], references: [id], onDelete: Cascade)
  subject     Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classRoom   ClassRoom        @relation(fields: [classRoomId], references: [id], onDelete: Cascade)
  supervisors ExamSupervisor[]
  grades      Grade[]

  @@index([examSessionId])
  @@index([subjectId])
  @@index([classRoomId])
  @@map("exams")
}

// Surveillance d'examen (exigence "Surveillance" du module Examens).
model ExamSupervisor {
  examId     String
  employeeId String

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([examId, employeeId])
  @@index([employeeId])
  @@map("exam_supervisors")
}

model Grade {
  id        String  @id @default(uuid())
  examId    String
  studentId String
  score     Float
  comment   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
  @@map("grades")
}

// ==========================================================================
// Module 7 : Discipline & Communication
// ==========================================================================

// Sanctions, récompenses, retards et observations (le suivi des absences
// proprement dit reste géré par StudentAttendance, Module 5).
model DisciplineRecord {
  id          String   @id @default(uuid())
  schoolId    String
  studentId   String
  type        String
  severity    String   @default("LOW")
  title       String
  description String?
  recordedBy  String? // userId de l'auteur (surveillant, enseignant, direction)
  date        DateTime @default(now())

  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([studentId])
  @@index([type])
  @@map("discipline_records")
}

// Messagerie interne (un message, plusieurs destinataires).
model Message {
  id        String   @id @default(uuid())
  schoolId  String
  senderId  String
  subject   String
  body      String
  createdAt DateTime @default(now())

  sender     User               @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipients MessageRecipient[]

  @@index([schoolId])
  @@index([senderId])
  @@map("messages")
}

model MessageRecipient {
  id          String    @id @default(uuid())
  messageId   String
  recipientId String
  readAt      DateTime?

  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recipient User    @relation("MessagesReceived", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([messageId, recipientId])
  @@index([recipientId])
  @@map("message_recipients")
}

// Annonces diffusées à un public cible (exigence "Annonces").
model Announcement {
  id          String   @id @default(uuid())
  schoolId    String
  authorId    String
  title       String
  body        String
  audience    String   @default("ALL")
  publishedAt DateTime @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([audience])
  @@map("announcements")
}

// Notification adressée à un utilisateur, potentiellement relayée par
// e-mail/SMS via un fournisseur externe pluggable (voir
// communication/providers dans le backend) — exigence "Notifications / SMS / Email".
model Notification {
  id             String    @id @default(uuid())
  schoolId       String
  userId         String
  title          String
  body           String
  channel        String    @default("IN_APP")
  deliveryStatus String    @default("QUEUED")
  link           String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([userId])
  @@map("notifications")
}

// ==========================================================================
// Module 8 : Finances (Frais, Paiements, Bourses, Réductions, Factures, Reçus)
// ==========================================================================

// Catégorie de frais (exigence "Frais scolaires / Catégories"), ex:
// "Frais de scolarité", "Frais d'inscription", "Cantine", "Transport".
model FeeCategory {
  id          String  @id @default(uuid())
  schoolId    String
  name        String
  description String?

  invoices  Invoice[]
  schedules FeeSchedule[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("fee_categories")
}

// Barème de frais : montant standard d'une catégorie pour une classe/année,
// utilisé comme modèle pour générer les factures des élèves.
model FeeSchedule {
  id            String    @id @default(uuid())
  schoolId      String
  feeCategoryId String
  classRoomId   String?
  schoolYearId  String?
  amount        Float
  dueDate       DateTime?

  feeCategory FeeCategory @relation(fields: [feeCategoryId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([feeCategoryId])
  @@map("fee_schedules")
}

// Facture (exigence "Factures"). Le solde est déduit dynamiquement de la
// somme des paiements (Payment) associés — voir invoice.service.ts.
model Invoice {
  id             String    @id @default(uuid())
  schoolId       String
  studentId      String
  feeCategoryId  String
  schoolYearId   String?
  invoiceNo      String    @unique // ex: "FAC-2026-000123"
  amount         Float // montant brut avant réduction/bourse
  discountAmount Float     @default(0)
  dueDate        DateTime?
  status         String    @default("PENDING")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeCategory FeeCategory @relation(fields: [feeCategoryId], references: [id], onDelete: Cascade)
  payments    Payment[]

  @@index([schoolId])
  @@index([studentId])
  @@index([feeCategoryId])
  @@index([status])
  @@map("invoices")
}

// Versement / paiement (exigence "Paiements / Versements / Reçus").
model Payment {
  id         String   @id @default(uuid())
  invoiceId  String
  amount     Float
  method     String   @default("CASH")
  receiptNo  String   @unique // ex: "REC-2026-000123"
  paidAt     DateTime @default(now())
  recordedBy String?
  note       String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payments")
}

// Bourse ou réduction accordée à un élève (exigence "Bourses / Réductions").
// Appliquée au moment de la génération de facture (snapshot dans
// Invoice.discountAmount) pour garder un historique fiable même si la
// bourse est modifiée par la suite.
model FinancialAid {
  id           String  @id @default(uuid())
  schoolId     String
  studentId    String
  type         String
  label        String // ex: "Bourse d'excellence", "Réduction fratrie"
  percentage   Float? // ex: 50 pour -50%
  fixedAmount  Float? // montant fixe alternatif au pourcentage
  schoolYearId String?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([studentId])
  @@map("financial_aids")
}

// ==========================================================================
// Module 9 : Caisse (ouverture/fermeture, entrées/sorties, journal, reçus)
// ==========================================================================

// Une caisse physique de l'établissement (accueil, cantine, etc.).
model CashRegister {
  id       String  @id @default(uuid())
  schoolId String
  name     String // ex: "Caisse principale"
  location String?
  isActive Boolean @default(true)

  sessions CashSession[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("cash_registers")
}

// Une session de caisse : de l'ouverture à la fermeture, avec un solde de
// départ et un solde déclaré à la clôture (comparé au solde attendu calculé
// à partir des transactions) — exigences "Ouverture / Fermeture / Solde".
model CashSession {
  id                     String    @id @default(uuid())
  cashRegisterId         String
  openedBy               String
  openedAt               DateTime  @default(now())
  openingBalance         Float
  closedBy               String?
  closedAt               DateTime?
  declaredClosingBalance Float?
  status                 String    @default("OPEN")

  cashRegister CashRegister      @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  transactions CashTransaction[]

  @@index([cashRegisterId])
  @@index([status])
  @@map("cash_sessions")
}

// Entrée ou sortie de caisse (exigences "Entrées / Sorties / Journal /
// Validation"). Chaque mouvement peut nécessiter une validation par un
// responsable avant d'être compté dans le solde attendu.
model CashTransaction {
  id            String    @id @default(uuid())
  cashSessionId String
  type          String
  amount        Float
  category      String // ex: "Frais scolaires", "Fournitures", "Transport"
  description   String?
  status        String    @default("VALIDATED")
  receiptNo     String    @unique // ex: "CAI-2026-000123"
  recordedBy    String?
  validatedBy   String?
  validatedAt   DateTime?
  createdAt     DateTime  @default(now())

  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)

  @@index([cashSessionId])
  @@index([status])
  @@map("cash_transactions")
}

// ==========================================================================
// Module 10 : Comptabilité (Journal, Balance, Grand livre)
// ==========================================================================

// Plan comptable simplifié de l'établissement.
model ChartOfAccount {
  id       String @id @default(uuid())
  schoolId String
  code     String // ex: "512", "706", "641"
  name     String // ex: "Banque", "Produits scolarité", "Salaires"
  type     String

  lines JournalLine[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("chart_of_accounts")
}

// Une écriture comptable : un ensemble de lignes en partie double
// (somme des débits = somme des crédits) — exigence "Journal comptable".
model JournalEntry {
  id         String   @id @default(uuid())
  schoolId   String
  date       DateTime @default(now())
  label      String
  sourceType String   @default("MANUAL")
  sourceId   String?
  createdBy  String?
  createdAt  DateTime @default(now())

  lines JournalLine[]

  @@index([schoolId])
  @@index([date])
  @@map("journal_entries")
}

model JournalLine {
  id             String @id @default(uuid())
  journalEntryId String
  accountId      String
  debit          Float  @default(0)
  credit         Float  @default(0)

  journalEntry JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}

// ==========================================================================
// Module 14 : Paramètres avancés, Sauvegarde/Restauration, Sync Offline
// ==========================================================================

// Paramètres système clé/valeur (langue, thème, préférences diverses) —
// exigence "Langues / Thèmes" au-delà des champs fixes déjà présents sur School.
model SystemSetting {
  id       String @id @default(uuid())
  schoolId String
  key      String // ex: "language", "theme", "default_currency_display"
  value    String // stocké en texte (JSON si structure complexe)

  updatedAt DateTime @updatedAt

  @@unique([schoolId, key])
  @@index([schoolId])
  @@map("system_settings")
}

// Historique des sauvegardes — exigence "Sauvegarde / Restauration".
model BackupRecord {
  id           String    @id @default(uuid())
  schoolId     String
  type         String    @default("MANUAL")
  status       String    @default("PENDING")
  fileName     String?
  sizeBytes    Int?
  modelCounts  String? // ex: {"Student": 320, "Employee": 45, ...}
  triggeredBy  String?
  errorMessage String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  @@index([schoolId])
  @@map("backup_records")
}

// Journal de synchronisation Offline (SQLite) ⇄ Serveur (PostgreSQL) —
// exigence "Synchronisation automatique". Chaque ligne trace un lot
// synchronisé depuis/vers un appareil identifié par deviceId.
model SyncLog {
  id           String   @id @default(uuid())
  schoolId     String
  deviceId     String
  direction    String
  status       String   @default("SUCCESS")
  recordCount  Int      @default(0)
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([schoolId])
  @@index([deviceId])
  @@map("sync_logs")
}

// --------------------------------------------------------------------------
// Audit complet — journal système (exigence "Audit complet / Historique des actions")
// --------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  schoolId   String?
  userId     String?
  action     String // ex: "AUTH_LOGIN", "STUDENT_CREATE"
  entityType String?
  entityId   String?
  metadata   String
  ipAddress  String?
  createdAt  DateTime @default(now())

  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}
