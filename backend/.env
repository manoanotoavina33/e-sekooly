NODE_ENV=development
PORT=4000

# Mode Serveur (PostgreSQL) :
DATABASE_URL="postgresql://postgres:admin@localhost:5432/e-sekooly?schema=public"
# Mode Offline (SQLite) — basculez le provider dans schema.prisma puis :
# DATABASE_URL="file:./dev.db"

JWT_ACCESS_SECRET="remplacer-par-un-secret-fort"
JWT_REFRESH_SECRET="remplacer-par-un-autre-secret-fort"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS=30

CORS_ORIGIN="http://localhost:5173"
